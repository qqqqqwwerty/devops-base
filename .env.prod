COMPOSE_PROJECT_NAME=prod-stack
APP_ENV=production
APP_PORT=5001
LOG_PATH=/var/log/app/access.log
SECRET_KEY=change-me-in-real-deployment

# Database Settings
POSTGRES_USER=admin
POSTGRES_PASSWORD=super_secret
POSTGRES_DB=myapp

# Nginx config: use the Let's Encrypt config in production
NGINX_CONFIG=nginx.conf

# Monitoring Ports
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
